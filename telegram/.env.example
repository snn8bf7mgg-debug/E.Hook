# Local API configuration. Copy to .env for local development; never commit .env.
HOST=127.0.0.1
PORT=8787
NODE_ENV=development

# Required for production Telegram Mini App authentication. Keep server-side only.
TELEGRAM_BOT_TOKEN=replace-with-bot-token

# Optional local browser testing. Enabled only in development on a loopback HOST.
# The browser sends only the enablement header; the synthetic account ID stays server-side.
TELEGRAM_DEV_AUTH=true
TELEGRAM_DEV_USER_ID=987654321

# Supabase project configuration. Keep the service role key on the server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
